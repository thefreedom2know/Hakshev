<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        style="@style/HkTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_hydration" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/HkBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/daily_target" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTargetMinus"
            style="@style/HkStepButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="−" />

        <TextView
            android:id="@+id/tvTarget"
            style="@style/HkBody"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTargetPlus"
            style="@style/HkStepButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="+" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvParades"
        style="@style/HkBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:textSize="15sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnParade"
            style="@style/HkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/drink_parade" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/HkButtonOutlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/reset_day" />
    </LinearLayout>
</LinearLayout>
